# Emails allowed to open the /analytics dashboard, comma-separated.
# Copy this file to .env.local and fill in the consortium's admin accounts.
# The same addresses must be listed in firestore.rules — see that file.
VITE_ADMIN_EMAILS=

# Optional. Pins the base URL printed on certificates for verification links.
# Leave blank to derive it from wherever the app is served, which is correct
# for localhost and GitHub Pages alike. Set it only if certificates are
# generated somewhere other than the canonical public host.
# VITE_PUBLIC_URL=https://etizebrar.github.io/mooc/
